// 方腔（三角形棱柱非结构网格），顶盖 U = 50，ν = 0.01，Re = 5000（原 cavity2d_unstructured 算例）
{
  "mesh": { "polyMesh": "../../meshes/cavity2D_tri/polyMesh" },
  "physics": { "nu": 0.01, "steady": true },
  "boundary": {
    "movingWall": { "U": {"type": "fixedValue", "value": [50, 0, 0]}, "p": {"type": "zeroGradient"} },
    "fixedWalls": { "U": {"type": "noSlip"}, "p": {"type": "zeroGradient"} }
  },
  "schemes": { "div": "linearUpwind" },  // 用 MUSCL 时 SIMPLE 残差会停在 1e-4 左右（限制器反复切换）
  "solution": { "alphaU": 0.7, "alphaP": 0.3, "nNonOrthCorr": 2 },
  "run": { "maxIter": 50000, "residualTol": 1e-6, "output": "output", "printInterval": 500 },
  "lines": [ { "name": "xMid", "start": [0.5, 0, 0.005], "end": [0.5, 1, 0.005], "n": 101 } ]
}
