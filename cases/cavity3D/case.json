// 三维方腔（四面体非结构网格），顶盖 U = 16，ν = 0.01，Re = 1600（原 cavity3d_unstructured 算例）
{
  "mesh": { "polyMesh": "../../meshes/cavity3D_4/polyMesh" },
  "physics": { "nu": 0.01, "steady": true },
  "boundary": {
    "movingWall": { "U": {"type": "fixedValue", "value": [16, 0, 0]}, "p": {"type": "zeroGradient"} },
    "fixedWalls": { "U": {"type": "noSlip"}, "p": {"type": "zeroGradient"} }
  },
  "schemes": { "div": "linearUpwind" },  // MUSCL 在该四面体网格（最大非正交 65°）上 SIMPLE 残差停滞
  "solution": { "alphaU": 0.7, "alphaP": 0.3, "nNonOrthCorr": 2 },
  "run": { "maxIter": 15000, "residualTol": 1e-6, "output": "output", "printInterval": 500 }
}
