// 同 parabolic.json，入口剖面由表文件 inlet_profile.csv（y, u, v, w，41 点）线性插值给出
{
  "mesh": { "box": { "n": [80, 20, 1], "hi": [4, 1, 0.1], "twoD": true, "walls": ["yMin", "yMax"],
                     "names": { "xMin": "inlet", "xMax": "outlet" } } },
  "physics": { "nu": 0.05, "steady": true },
  "boundary": {
    "inlet":  { "U": { "type": "fixedValue", "profile": { "file": "inlet_profile.csv", "axis": "y" } },
                "p": { "type": "zeroGradient" } },
    "outlet": { "U": { "type": "inletOutlet", "inletValue": [0, 0, 0] }, "p": { "type": "fixedValue", "value": 0 } }
  },
  "initial": { "U": [1, 0, 0] },
  "schemes": { "div": "linear" },
  "run": { "maxIter": 4000, "residualTol": 1e-9, "printInterval": 200, "vtk": false, "printFluxes": true },
  "lines": [ { "name": "outlet", "start": [3.975, 0, 0.05], "end": [3.975, 1, 0.05], "n": 20 },
             { "name": "centre", "start": [0, 0.525, 0.05], "end": [4, 0.525, 0.05], "n": 80 } ]
}
