// 湍流槽道传热：Re_b = U_b δ/ν = 6875（Re_τ ≈ 392），Pr = 0.71，均匀体积热源 Q = 1、两壁等温 T = 0（流向周期）
//   稳态时壁面热流 q_w = Q δ；对比：T+ 剖面与 Kader 1981 律、Nu（D_h = 4δ）与 Gnielinski 关联式
//   python3 tools/compare_channel_heat.py output --log log.txt
{
  "mesh": { "box": { "n": [4, 120, 1], "hi": [1, 2, 0.1], "periodic": [true, false, false], "twoD": true,
                     "walls": ["yMin", "yMax"], "stretch": { "y": 3.0 } } },
  "physics": { "nu": 1.4545454545e-4, "steady": true },
  "forcing": { "type": "meanVelocity", "Ubar": [1, 0, 0] },
  "turbulence": { "model": "kOmegaSST" },
  "energy": { "Pr": 0.71, "Prt": 0.85, "source": 1.0, "nusselt": { "L": 4.0, "deltaT": 1.0 } },
  "boundary": { "yMin": { "T": { "type": "fixedValue", "value": 0.0 } },
                "yMax": { "T": { "type": "fixedValue", "value": 0.0 } } },
  "initial": { "U": [1, 0, 0], "k": 0.005, "omega": 50, "T": 0.0 },
  "schemes": { "div": "linearUpwind" },
  "run": { "maxIter": 8000, "residualTol": 1e-8, "printInterval": 1000, "vtk": false },
  "lines": [ { "name": "profile", "start": [0.5, 0, 0.05], "end": [0.5, 1, 0.05], "n": 200 } ]
}
