// 顶盖驱动方腔 Re = 100（与 Ghia 1982 对比：output/line_xMid_U.csv）
{
  "mesh": { "box": { "n": [64, 64, 1], "hi": [1, 1, 0.1], "twoD": true,
                     "walls": ["xMin", "xMax", "yMin", "yMax"], "names": {"yMax": "lid"} } },
  "physics": { "nu": 0.01, "steady": true },
  "boundary": {
    "lid": { "U": {"type": "fixedValue", "value": [1, 0, 0]} }
  },
  "schemes": { "div": "linearUpwind" },
  "run": { "maxIter": 5000, "residualTol": 1e-6, "output": "output", "printInterval": 200 },
  "lines": [
    { "name": "xMid", "start": [0.5, 0, 0.05], "end": [0.5, 1, 0.05], "n": 64 },
    { "name": "yMid", "start": [0, 0.5, 0.05], "end": [1, 0.5, 0.05], "n": 64 }
  ]
}
