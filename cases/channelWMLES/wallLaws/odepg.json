// 粗网格壁模型 LES 槽道 Re_τ ≈ 1000（Lee & Moser 2015），壁面律对比用：一维薄层方程含切向压力梯度 / 体力（非平衡；槽道中 u_τ 预期偏高 1–3 %，见 docs/validation.md）
//   48×24×32（Δx+ ≈ 131，Δz+ ≈ 62，首层中心 y+ ≈ 31），采样高度 0.175H（第三层单元），WALE + Van Driest
//   t = 400 起统计到 600（T_c = H/u_τ ≈ 20）；对比：python3 tools/compare_channel.py output/channel_stats.csv --ref ../reference/referenceData_1000.csv
//   同目录四个算例只有 wallModel 不同；完整分辨率的 Spalding 结果见 ../case.json
{
  "mesh": { "box": { "n": [48, 24, 32], "hi": [6.283185307179586, 3.141592653589793, 2],
                     "periodic": [true, true, false], "walls": ["zMin", "zMax"] } },
  "physics": { "nu": 5e-5, "steady": false },
  "forcing": { "type": "meanVelocity", "Ubar": [1, 0, 0] },
  "turbulence": { "model": "WALE", "vanDriest": true, "wallModel": { "type": "ode", "pressureGradient": true, "samplingHeight": 0.175 } },
  "initial": { "channel": { "Ubulk": 1, "streamwise": 0, "normal": 2, "walls": [0, 2], "amplitude": 0.1, "noise": 0.05 } },
  "schemes": { "div": "linear", "ddt": "backward" },
  "solution": { "nOuter": 1, "nCorr": 2, "nNonOrthCorr": 0 },
  "run": { "endTime": 600, "maxCo": 0.5, "maxDt": 0.05, "writeInterval": 100, "output": "output",
           "printInterval": 500, "restartWrite": "restart", "vtk": false },
  "channelStatistics": { "streamwise": 0, "normal": 2, "walls": [0, 2], "start": 400 }
}
