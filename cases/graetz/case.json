  "mesh": {
    "pipe": {
      "radius": 0.5,
      "length": 20.0,
      "nCore": 10,
      "nRing": 12,
      "nAxial": 200,
      "coreFrac": 0.5,
      "stretch": 1.6,
      "periodic": false
    }
  },
  "physics": {
    "nu": 0.01,
    "steady": true
  },
