    ],
    "p": 0,
    "T": 0.0
  },
  "schemes": {
    "div": "linearUpwind"
  },
  "solution": {
    "nNonOrthCorr": 1
  },
  "run": {
    "maxIter": 3000,
    "residualTol": 1e-07,
